<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Application palette (design §6.1: 断线/故障/屏蔽 must use colour + text + icon). -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavBarBackgroundBrush" Color="#20303F" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#2B3A49" />
    <SolidColorBrush x:Key="PageHostBackgroundBrush" Color="#EDEFF2" />

    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="InverseForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#7A8694" />

    <!-- Status colours: safe / online / healthy. -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2E7D32" />
    <!-- Transient / connecting / heartbeat lost. -->
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#F9A825" />
    <!-- Fault / e-stop / offline-critical. -->
    <SolidColorBrush x:Key="StatusAlertBrush" Color="#C62828" />
    <!-- Unknown / no data. -->
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#7A8694" />

    <!-- Alarm banner background. -->
    <SolidColorBrush x:Key="AlarmBannerBackgroundBrush" Color="#C62828" />

</ResourceDictionary>
