<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Configurable HMI theme (design §7 模块化可配置界面 + 磁贴看板): deep-blue industrial HMI palette.
         Shared by ConfigurablePageView (five-region shell) and DashboardView (tile board). -->

    <SolidColorBrush x:Key="ConfigUiBackgroundBrush" Color="#0A2A46" />
    <SolidColorBrush x:Key="ConfigUiHeaderBrush" Color="#0D3357" />
    <SolidColorBrush x:Key="ConfigUiPanelBrush" Color="#103E63" />
    <SolidColorBrush x:Key="ConfigUiButtonBrush" Color="#1E6FB8" />
    <SolidColorBrush x:Key="ConfigUiButtonHoverBrush" Color="#2A86D6" />
    <SolidColorBrush x:Key="ConfigUiAccentBrush" Color="#3EC1F0" />
    <SolidColorBrush x:Key="ConfigUiTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ConfigUiMutedTextBrush" Color="#A8C8E0" />
    <SolidColorBrush x:Key="ConfigUiInputBrush" Color="#0D3556" />
    <SolidColorBrush x:Key="ConfigUiGridLineBrush" Color="#2A6088" />
    <SolidColorBrush x:Key="ConfigUiTileBrush" Color="#123F66" />
    <SolidColorBrush x:Key="ConfigUiTileOkBrush" Color="#1F7A4D" />
    <SolidColorBrush x:Key="ConfigUiTileAlarmBrush" Color="#B23A3A" />

    <!-- HMI module button (menu / nav / command bar / big tile button): solid accent, rounded. -->
    <Style x:Key="ConfigUiModuleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ConfigUiButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ConfigUiButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small tile-board edit control button (↑ ↓ −列 +列 …). -->
    <Style x:Key="ConfigUiMiniButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ConfigUiButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ConfigUiButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HMI input (username / password / parameter fields / tile edit). -->
    <Style x:Key="ConfigUiInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ConfigUiInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource ConfigUiTextBrush}" />
    </Style>

    <!-- HMI card (login panel / parameter table / tile). -->
    <Style x:Key="ConfigUiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ConfigUiPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="ConfigUiCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ConfigUiMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tile edit drop-downs reuse Palette: ComboBox on the dark theme. -->
    <Style x:Key="ConfigUiComboStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ConfigUiInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
</ResourceDictionary>
