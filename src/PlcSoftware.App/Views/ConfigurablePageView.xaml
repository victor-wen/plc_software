<UserControl x:Class="PlcSoftware.App.Views.ConfigurablePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <!-- Configurable HMI theme (design §7 模块化可配置界面): deep-blue industrial HMI palette. -->
        <SolidColorBrush x:Key="ConfigUiBackgroundBrush" Color="#0A2A46" />
        <SolidColorBrush x:Key="ConfigUiHeaderBrush" Color="#0D3357" />
        <SolidColorBrush x:Key="ConfigUiPanelBrush" Color="#103E63" />
        <SolidColorBrush x:Key="ConfigUiButtonBrush" Color="#1E6FB8" />
        <SolidColorBrush x:Key="ConfigUiButtonHoverBrush" Color="#2A86D6" />
        <SolidColorBrush x:Key="ConfigUiAccentBrush" Color="#3EC1F0" />
        <SolidColorBrush x:Key="ConfigUiTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ConfigUiMutedTextBrush" Color="#A8C8E0" />
        <SolidColorBrush x:Key="ConfigUiInputBrush" Color="#0D3556" />
        <SolidColorBrush x:Key="ConfigUiGridLineBrush" Color="#2A6088" />

        <!-- HMI module button (menu / nav / command bar): solid accent, rounded, hover highlight. -->
        <Style x:Key="ConfigUiModuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ConfigUiButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ConfigUiButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HMI input (username / password / parameter fields). -->
        <Style x:Key="ConfigUiInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ConfigUiInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConfigUiAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource ConfigUiTextBrush}" />
        </Style>

        <!-- HMI card (login panel / parameter table). -->
        <Style x:Key="ConfigUiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConfigUiPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="ConfigUiCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ConfigUiMutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- The five fixed HMI regions: header / left menu / content / right nav / bottom command row. -->
    <Grid Background="{StaticResource ConfigUiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost" Grid.Row="0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="MenuHost" Grid.Column="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="ContentHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="NavHost" Grid.Column="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <ContentControl x:Name="CommandBarHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
