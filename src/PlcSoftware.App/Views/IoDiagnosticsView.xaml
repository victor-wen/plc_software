<UserControl x:Class="PlcSoftware.App.Views.IoDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- I/O diagnostics page (design §6.6): X/Y/M grouped read-only presentation. The whole data region
             greys out (opacity) when offline (design §5.3); the header stays readable so the frozen connection
             text never greys. The table has NO write entry — every cell is a read-only TextBlock. -->
        <Style x:Key="IoGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,12,4,4" />
        </Style>

        <!-- A single read-only row: 地址 | 名称 | 状态. No button, no edit box — a table has no force-write entry. -->
        <Style x:Key="IoRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>

        <Style x:Key="IoAddressStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IoNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- State colour (design §6.1: colour + text redundancy). 接通 green, 断开 neutral, 未上报 muted. -->
        <Style x:Key="IoStateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: connection; readable even offline. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,8">
                <TextBlock Text="I/O 诊断"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
                <TextBlock Text="连接："
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="16,6,2,0" />
                <TextBlock Text="{Binding ConnectionStatusText}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="只读——手动动作请在「手动」页执行"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="40,6,0,0" />
            </StackPanel>

            <!-- Read-only X/Y/M groups (design §6.6). -->
            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource IoGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="输入 X" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,4" />
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IoRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource IoNameStyle}" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource IoStateStyle}" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IoGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="输出 Y" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,4" />
                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IoRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource IoNameStyle}" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource IoStateStyle}" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IoGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="继电器 M" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,4" />
                        <ItemsControl ItemsSource="{Binding Relays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IoRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource IoNameStyle}" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource IoStateStyle}" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
