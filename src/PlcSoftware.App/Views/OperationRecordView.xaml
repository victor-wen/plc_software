<UserControl x:Class="PlcSoftware.App.Views.OperationRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 威纶通深蓝 HMI 表格基础样式（须先于 DataGrid 定义，避免 StaticResource 前向引用） -->
        <Style x:Key="HmiColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ConfigUiHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="HmiCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E5A8A" />
                    <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HmiDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ConfigUiPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E5A8A" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#184A73" />
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#143A5A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HmiDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ConfigUiPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource ConfigUiPanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#143A5A" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConfigUiGridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource HmiColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource HmiCellStyle}" />
        </Style>
        <!-- 复用的黄色警告条（威纶通风格 · 深蓝底上的黄色横幅） -->
        <Style x:Key="YellowBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#F2C94C" />
            <Setter Property="BorderBrush" Value="#E0B63C" />
            <Setter Property="BorderThickness" Value="0,1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="YellowBannerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1B1B1B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HmiTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HmiMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ConfigUiMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HmiMutedStyle}">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ConfigUiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（威纶通深蓝） -->
        <Border Grid.Row="0"
                Background="{StaticResource ConfigUiHeaderBrush}"
                BorderBrush="{StaticResource ConfigUiAccentBrush}"
                BorderThickness="0,0,0,2"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="4" Height="20" Background="{StaticResource ConfigUiAccentBrush}" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="操作记录" Style="{StaticResource HmiTitleStyle}" />
                    <TextBlock Text="OPERATION LOG" Foreground="{StaticResource ConfigUiMutedTextBrush}" FontSize="10" Margin="8,4,0,0" VerticalAlignment="Center" Opacity="0.9" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="连接：" Style="{StaticResource HmiMutedStyle}" />
                    <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{StaticResource ConfigUiTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HmiMutedStyle}">
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Foreground" Value="#7ED8A6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding LastQuerySummary}" Style="{StaticResource HmiMutedStyle}" Margin="16,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 黄色警告条（复用） -->
        <Border Grid.Row="1" Style="{StaticResource YellowBannerStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="⚠" FontSize="14" Foreground="#1B1B1B" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="只读展示 · 来源：本地审计库（audit_events）— 操作/参数/屏蔽/调试记录" Style="{StaticResource YellowBannerTextStyle}" />
            </DockPanel>
        </Border>

        <!-- 查询栏 -->
        <Border Grid.Row="2" Style="{StaticResource ConfigUiCardStyle}" Margin="12,12,12,8" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="从" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center" />
                    <DatePicker Width="140" SelectedDate="{Binding DateFrom}" Margin="0,0,8,0" />
                    <TextBlock Text="到" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center" />
                    <DatePicker Width="140" SelectedDate="{Binding DateTo}" Margin="0,0,12,0" />
                    <Button Content="查询" Style="{StaticResource ConfigUiModuleButtonStyle}" Padding="16,5" MinWidth="0" Command="{Binding QueryCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource ConfigUiMutedTextBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="420" />
            </DockPanel>
        </Border>

        <!-- 数据表格（DataGrid 深蓝主题） -->
        <Border Grid.Row="3" Margin="12,0,12,8" Background="{StaticResource ConfigUiPanelBrush}"
                BorderBrush="{StaticResource ConfigUiGridLineBrush}" BorderThickness="1" CornerRadius="8" Padding="0" ClipToBounds="True">
            <DataGrid Style="{StaticResource HmiDataGridStyle}"
                      RowStyle="{StaticResource HmiDataGridRowStyle}"
                      AlternationCount="2"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="用户" Binding="{Binding User}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiMutedTextBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiAccentBrush}" />
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ConfigUiTextBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="#F2C94C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="{StaticResource ConfigUiMutedTextBrush}" FontSize="12"
                   Margin="16,0,16,12" TextWrapping="Wrap" />
    </Grid>
</UserControl>
