<UserControl x:Class="PlcSoftware.App.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Parameter page (design §6.5): editable D201/D202/D204/D205 + read-only D203/D210/D212.D213.
             The whole data region greys out (opacity) when offline (design §5.3); the header stays readable
             so the frozen connection text never greys. -->
        <Style x:Key="ParameterGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,12,4,4" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="EditableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EDEFF2" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: connection; readable even offline. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,8">
                <TextBlock Text="参数"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
                <TextBlock Text="连接："
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="16,6,2,0" />
                <TextBlock Text="{Binding ConnectionStatusText}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Read-only data (design §6.5: 显示 D203、D210、D212-D213). -->
            <Border Grid.Row="1" Style="{StaticResource ParameterGroupStyle}">
                <StackPanel>
                    <TextBlock Text="只读数据" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,4" />
                    <ItemsControl ItemsSource="{Binding ReadOnlyParameters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitleStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource CardValueStyle}" />
                                            <TextBlock Text="{Binding Unit}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       Margin="4,10,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Editable parameters (design §6.5: 写入前显示旧值、新值、单位和允许范围). -->
            <Border Grid.Row="2" Style="{StaticResource ParameterGroupStyle}">
                <StackPanel>
                    <TextBlock Text="可编辑参数" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,4" />
                    <ItemsControl ItemsSource="{Binding WritableParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EditableRowStyle}">
                                    <StackPanel>
                                        <!-- Old value + unit + allowed range (design §6.5). -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                                            <TextBlock Text="当前：" Style="{StaticResource CardTitleStyle}" Margin="12,3,0,0" />
                                            <TextBlock Text="{Binding OldValue}" Style="{StaticResource CardTitleStyle}" Margin="2,3,0,0" />
                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource CardTitleStyle}" Margin="2,3,0,0" />
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Margin="24,3,0,0">
                                                <Run Text="允许范围：" />
                                                <Run Text="{Binding RangeHintText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Integer input + 写入 (design §6.5 整数输入). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox Width="120"
                                                     Padding="6,4"
                                                     FontSize="14"
                                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="写入"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.PrepareWriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- Input/range validation error. -->
                                        <TextBlock Text="{Binding Error}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource StatusAlertBrush}"
                                                   Margin="4,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Confirmation prompt: old → new, unit, allowed range (design §6.5). -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ConfirmationText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusWarnBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="确认"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding DataContext.ConfirmWriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button Content="取消"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.CancelWriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>

                                        <!-- Read-back outcome (design §6.5 结果反馈). -->
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource StatusNeutralBrush}"
                                                   Margin="4,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
