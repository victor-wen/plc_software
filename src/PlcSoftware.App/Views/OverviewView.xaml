<UserControl x:Class="PlcSoftware.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Read-only overview cards (design §6.2). Offline knocks the whole data region's opacity down. -->
        <Style x:Key="DataSectionStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="130" />
        </Style>

        <Style x:Key="StepTileIndexStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,12,4,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: kept readable even offline so the frozen last-update time never greys out. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,8">
                <TextBlock Text="总览"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
                <TextBlock Text="连接："
                           Style="{StaticResource CardTitleStyle}"
                           Margin="16,4,2,0" />
                <TextBlock Text="{Binding ConnectionStatusText}"
                           Foreground="{StaticResource StatusNeutralBrush}"
                           Margin="0,4,0,0" />
                <TextBlock Text="最后更新："
                           Style="{StaticResource CardTitleStyle}"
                           Margin="40,4,2,0" />
                <TextBlock Text="{Binding LastUpdateText}"
                           Foreground="{StaticResource PrimaryForegroundBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Data region: greys out (opacity) when offline. -->
            <StackPanel Grid.Row="1" Style="{StaticResource DataSectionStyle}">
                <TextBlock Text="流程步骤" Style="{StaticResource SectionLabelStyle}" />
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 0" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="等待进板" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 1" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="进料" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 2" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="挡停定位" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 3" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="触发相机" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 4" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="请求放行" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="步骤 5" Style="{StaticResource StepTileIndexStyle}" />
                            <TextBlock Text="放行" FontSize="14" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InverseForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="关键传感器 / 挡停" Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="安全光栅 X7" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding LightCurtainStatus}" FontSize="16" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LightCurtain}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="前门 X16" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding FrontDoorStatus}" FontSize="16" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FrontDoor}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="后门 X17" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding RearDoorStatus}" FontSize="16" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RearDoor}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="气压 X22" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding AirPressureStatus}" FontSize="16" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AirPressure}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="挡停" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding StopperStatus}" Style="{StaticResource CardValueStyle}" FontSize="16" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Text="宽度 / 速度 / 产量" Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="当前宽度 (mm)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding CurrentWidth}" Style="{StaticResource CardValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="目标宽度 (mm)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding TargetWidth}" Style="{StaticResource CardValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="皮带速度 (Hz)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding BeltSpeed}" Style="{StaticResource CardValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="产量" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding ProductionCount}" Style="{StaticResource CardValueStyle}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
