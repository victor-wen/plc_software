<UserControl x:Class="PlcSoftware.App.Views.CylinderControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,12,4,4" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EDEFF2" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 到位指示灯：绿=到位，灰=未到位/未配置 -->
        <Style x:Key="LampStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Fill" Value="#B0BEC5" />
            <Setter Property="Stroke" Value="#78909C" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style x:Key="RowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,8">
                <TextBlock Text="气缸控制" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                <TextBlock Text="连接：" Style="{StaticResource CardTitleStyle}" Margin="16,6,2,0" />
                <TextBlock Text="{Binding ConnectionStatusText}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusAlertBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="到位指示绑定 M303/M304/M313 等现有位，其余显示“未配置”" Style="{StaticResource SectionLabelStyle}" Margin="24,6,0,0" />
            </StackPanel>

            <!-- 气缸表格 -->
            <Border Grid.Row="1" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <!-- 表头 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="左侧" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="气缸" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="右侧" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Cylinders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧：按钮 + 指示灯 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Content="{Binding LeftAction}" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" ToolTip="{Binding LeftSensorKey, StringFormat=到位信号 {0}}" />
                                            <!-- 绿灯：LeftSensor==True 时亮绿 -->
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource LampStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LeftSensor}" Value="True">
                                                                <Setter Property="Fill" Value="#2E7D32" />
                                                                <Setter Property="Stroke" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LeftSensor}" Value="False">
                                                                <Setter Property="Fill" Value="#E0E0E0" />
                                                                <Setter Property="Stroke" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding LeftSensorText}" FontSize="10" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>

                                        <!-- 中间：气缸名 -->
                                        <Border Grid.Column="1" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8,4" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 右侧：指示灯 + 按钮（镜像） -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding RightSensorText}" FontSize="10" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Ellipse Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource LampStyle}">
                                                        <Setter Property="Margin" Value="0,0,6,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RightSensor}" Value="True">
                                                                <Setter Property="Fill" Value="#2E7D32" />
                                                                <Setter Property="Stroke" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RightSensor}" Value="False">
                                                                <Setter Property="Fill" Value="#E0E0E0" />
                                                                <Setter Property="Stroke" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Button Content="{Binding RightAction}" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" ToolTip="{Binding RightSensorKey, StringFormat=到位信号 {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="* 缩回/释放/上升 为左侧动作，伸出/夹紧/下降 为右侧动作；绿灯=到位，灰灯=未到位/未配置；按钮当前为只读占位，未接命令" FontSize="10" Foreground="{StaticResource MutedForegroundBrush}" Margin="4,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
