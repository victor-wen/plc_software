<UserControl x:Class="PlcSoftware.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 报警与历史 page (design §7): date-range query of alarms and host-write audit rows, and CSV export.
             The page is READ-ONLY: it displays persisted records, it writes nothing to the PLC. All data flows
             through the injected HistoryViewModel; failures surface on StatusText and never crash the app. -->
        <Style x:Key="HistoryGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="HistoryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,12,4,4" />
        </Style>

        <Style x:Key="HistoryRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <!-- Query bar -->
            <Border Style="{StaticResource HistoryGroupStyle}">
                <StackPanel>
                    <TextBlock Text="报警与历史（本地持久化记录，只读）" Style="{StaticResource HistoryLabel}" FontSize="14" Foreground="{StaticResource PrimaryForegroundBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="4,8">
                        <TextBlock Text="从 " VerticalAlignment="Center" Style="{StaticResource HistoryLabel}" />
                        <DatePicker Width="140" SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" 到 " VerticalAlignment="Center" Style="{StaticResource HistoryLabel}" />
                        <DatePicker Width="140" SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="查询" Width="90" Margin="12,0,0,0" Command="{Binding QueryCommand}" />
                        <Button Content="导出 CSV" Width="100" Margin="12,0,0,0" Command="{Binding ExportCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource StatusAlertBrush}" Margin="4,8,4,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Alarms -->
            <TextBlock Text="报警记录" Style="{StaticResource HistoryLabel}" />
            <Border Style="{StaticResource HistoryGroupStyle}">
                <ItemsControl ItemsSource="{Binding AlarmRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HistoryRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Audit -->
            <TextBlock Text="操作 / 审计记录" Style="{StaticResource HistoryLabel}" />
            <Border Style="{StaticResource HistoryGroupStyle}">
                <ItemsControl ItemsSource="{Binding AuditRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HistoryRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
