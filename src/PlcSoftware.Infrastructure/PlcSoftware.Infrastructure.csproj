<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- win-x64 is declared because the desktop app consumes these libraries from its win-x64
         self-contained publish graph; keeping the runtime graph stable makes the locked-mode
         restore agree in both the plain solution restore and the -r win-x64 publish restore. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NModbus" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlcSoftware.Core\PlcSoftware.Core.csproj" />
  </ItemGroup>

</Project>
